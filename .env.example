# ====================================
# FB Media Downloader - Cấu hình môi trường
# ====================================
# HƯỚNG DẪN:
# 1. Copy file này thành .env:  copy .env.example .env
# 2. Điền API Key & Token của bạn vào bên dưới

# --- Gemini AI (Bắt buộc cho tính năng --rewrite) ---
# Lấy key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Cấu hình tải video ---
# Số mili-giây chờ giữa mỗi lần tải (tránh bị Facebook chặn)
DOWNLOAD_DELAY_MS=3000

# Số mili-giây chờ sau mỗi lần gọi Gemini API (tránh Rate Limit 429)
REWRITE_DELAY_MS=5000

# --- Cấu hình cắt video mặc định (giây) ---
DEFAULT_TRIM_START=1
DEFAULT_TRIM_END=1

# --- GitHub (để đồng bộ code lên GitHub bằng npm run sync) ---
# Lấy token tại: https://github.com/settings/tokens/new → tick scope: repo
GITHUB_TOKEN=your_github_token_here
GITHUB_USERNAME=your_github_username

# --- Đăng nhập Facebook Tự Động ---
# Chỉ cần thiết lập nếu muốn tự động đăng nhập khi session hết hạn.
# Lưu ý: FB_2FA_SECRET là chuỗi khóa thiết lập (không phải mã 6 số).
FB_EMAIL=your_facebook_email
FB_PASSWORD=your_facebook_password
FB_2FA_SECRET=your_2fa_secret_here
