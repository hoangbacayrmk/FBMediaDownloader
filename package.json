{
  "name": "FBMediaDownloader",
  "version": "1.1.0",
  "description": "Công cụ tự động tải video Reels từ Facebook, kèm auto-edit (FFmpeg) và AI rewrite caption (Gemini).",
  "main": "chat_downloader.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node chat_downloader.js",
    "download": "node chat_downloader.js",
    "help": "node chat_downloader.js --help",
    "rewrite-all": "node scripts/batch_rewrite.js",
    "login": "node scripts/open_browser.js",
    "composer": "node scripts/open_composer.js",
    "sync": "node sync.js",
    "validate": "node -e \"const fs=require('fs'); if(!fs.existsSync('.env')){console.error('❌ File .env chưa tồn tại! Chạy: copy .env.example .env');process.exit(1)}else{console.log('✅ File .env OK')}\""
  },
  "type": "module",
  "keywords": ["facebook", "reels", "downloader", "automation", "puppeteer"],
  "author": "hoangbacayrmk",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "node-fetch": "^3.0.0",
    "puppeteer": "^24.43.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}
